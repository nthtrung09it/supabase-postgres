 hstore             | t
 http               | f
 hypopg             | t
 index_advisor      | t
 insert_username    | t
 intagg             | t
 intarray           | t
 isn                | t
 lo                 | t
 ltree              | t
 moddatetime        | t
 pageinspect        | t
 pg_buffercache     | t
 pg_freespacemap    | t
 pg_graphql         | f
 pg_hashids         | t
 pg_net             | f
 pg_partman         | f
 pg_prewarm         | t
 pg_repack          | f
 pg_stat_statements | t
 pg_surgery         | t
 pg_tle             | f
 pg_trgm            | t
 pg_visibility      | t
 pg_walinspect      | t
 pgaudit            | t
